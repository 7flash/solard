
# ---- Core database -----------------------------------------------------------
# SQLite DB path used by CLI, web routes, pump live store, jobs, and portfolio.
SOWL_DB_PATH=./sowl.db

# ---- Web console auth --------------------------------------------------------
# Optional. When set, browser/API calls must send x-solwal-web-token.
SOLWAL_WEB_TOKEN=change-me

# ---- RPC / Helius ------------------------------------------------------------
# Prefer HELIUS_RPC_URL. RPC_ENDPOINT is supported for compatibility.
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY
# RPC_ENDPOINT=
# HELIUS_API_KEY=

# Optional websocket override. If omitted and HELIUS_API_KEY is set, Solard derives
# wss://mainnet.helius-rpc.com/?api-key=...
# SOLWAL_HELIUS_WS_URL=

# Helius Sender / fast lane.
HELIUS_SENDER_URL=
HELIUS_TIP_ACCOUNT=
# Compatibility aliases:
# SOLWAL_HELIUS_TIP_ACCOUNT=
# SOWL_HELIUS_TIP_ACCOUNT=

# ---- Safety gates ------------------------------------------------------------
# Default is safe/dry-run. Live buy/sell/launch routes reject live=true unless
# this is explicitly set to 1.
SOLARD_ENABLE_LIVE_TRADES=0

# ---- Pump feed / launch ------------------------------------------------------
SOLARD_PUMP_FEED_SOURCE=helius
SOLARD_PUMP_LIVE_CURVE_MEMORY=250
# Compatibility alias:
# SOLWAL_PUMP_LIVE_CURVE_MEMORY=250

# Metadata upload provider for pump launches: pump-frontend or pinata.
PUMP_METADATA_PROVIDER=pump-frontend
# SOWL_METADATA_UPLOADER=pump-frontend

# Pinata metadata uploads require a JWT when PUMP_METADATA_PROVIDER=pinata.
PINATA_JWT=
PINATA_API_URL=https://api.pinata.cloud/pinning/pinFileToIPFS

# Optional endpoint override for pump frontend metadata uploader.
PUMP_METADATA_ENDPOINT=https://pump.fun/api/ipfs

# ---- Diagnostics -------------------------------------------------------------
SQLITE_DEBUG=0
SOLWAL_WEB_DEBUG=0
SOLARD_BOOT_LOG=1

# Phase 2/3 hardening
SOLARD_LOG_LEVEL=info
SOLARD_MAX_JOBS=100
SOLARD_MAX_JOB_LOGS=500
SOLARD_JOBS_PATH=./.solard/jobs.json
SOLARD_METADATA_CIRCUIT_FAILURES=5
SOLARD_METADATA_CIRCUIT_OPEN_MS=60000
SOLARD_METADATA_CIRCUIT_HALF_OPEN_AFTER_MS=10000
