PUMPPORTAL_API_KEY=replace-me

# Optional for Helius-specific APIs that require the raw key
# HELIUS_API_KEY=replace-me

# Required for wallet import/signing
# SLRD_MASTER_KEY=your-long-random-secret

# Chain access
# Configure exactly one endpoint. Solard derives standard WebSocket access from it.
RPC_ENDPOINT=https://mainnet.helius-rpc.com/?api-key=replace-me

# Web console API auth (required unless SOLARD_ALLOW_OPEN_WEB=1)
# SOLARD_WEB_TOKEN=your-local-api-token
# Legacy alias still accepted:
# SOLWAL_WEB_TOKEN=your-local-api-token
# SOLARD_ALLOW_OPEN_WEB=1

# Live trading master switch (simulation is the default)
# SOLARD_ENABLE_LIVE_TRADES=1
# Legacy aliases still accepted:
# SOLWAL_ENABLE_LIVE_TRADES=1
# SLRD_ENABLE_LIVE_TRADES=1

# Optional send lanes
# HELIUS_SENDER_URL=...
# HELIUS_TIP_ACCOUNT=...
# JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf

# Primary Pump lifecycle
SOLARD_PUMP_WS_CONNECTIONS=5
SOLARD_PUMP_SUBSCRIPTIONS_PER_CONNECTION=1000
SOLARD_PUMP_MAX_TRACKED_TOKENS=5000
SOLARD_PUMP_LIFECYCLE_REFRESH_MS=2000
SOLARD_PUMP_ACTIVE_WINDOW_MS=3600000
SOLARD_PUMP_CURVE_POLL_MS=5000
SOLARD_PUMP_CURVE_REPAIR_POLL_MS=60000
SOLARD_PUMP_REQUIRE_INTEREST_SIGNAL=false
SOLARD_PUMP_INTEREST_WINDOW_MS=1800000
SOLARD_PUMP_MIN_INTEREST_SCORE=0

# PumpSwap lifecycle
SOLARD_PUMPSWAP_WS_CONNECTIONS=5
SOLARD_PUMPSWAP_SUBSCRIPTIONS_PER_CONNECTION=1000
SOLARD_PUMPSWAP_MAX_TRACKED_TOKENS=5000
SOLARD_PUMPSWAP_LIFECYCLE_REFRESH_MS=2000
SOLARD_PUMPSWAP_ACTIVE_WINDOW_MS=86400000
SOLARD_PUMPSWAP_REPAIR_POLL_MS=60000
SOLARD_PUMPSWAP_HISTORY_MS=0

# Meteora DLMM
# Read-only endpoints can be overridden for self-hosted/proxied deployments.
# METEORA_DLMM_CLUSTER=mainnet-beta
# METEORA_DLMM_DATA_API_URL=https://dlmm.datapi.meteora.ag
# METEORA_POOL_DISCOVERY_API_URL=https://pool-discovery-api.datapi.meteora.ag
# Meteora write methods also require SOLARD_ENABLE_LIVE_TRADES=1 and an explicit { live: true } call option.

# Optional GMGN read-only OpenAPI tools (token/security/holders/traders/kline/trending/signals/gas data).
# Solard intentionally does not support GMGN signed swap/order execution.
# GMGN_API_KEY=...
# GMGN_API_URL=https://openapi.gmgn.ai
# SOLARD_EXTERNAL_HTTP_TIMEOUT_MS=10000
