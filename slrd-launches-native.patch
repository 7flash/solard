+} from "./schema.ts";
 import type { TransactionAction } from "../tx/types.ts";
 
 const m = measure("executions");
+
+export type LaunchExecutionRow = {
+  execution: ExecutionRow;
+  action: ExecutionActionRow;
+  alias: string | null;
+  symbol: string | null;
+};
+
+function launchActionMetadata(action: ExecutionActionRow): {
+  alias: string | null;
+  symbol: string | null;
+} {
+  try {
+    const parsed = JSON.parse(action.metadataJson) as Record<string, unknown>;
+    const alias =
+      typeof parsed.alias === "string" && parsed.alias.trim()
+        ? parsed.alias.trim()
+        : null;
+    const symbol =
+      typeof parsed.symbol === "string" && parsed.symbol.trim()
+        ? parsed.symbol.trim()
+        : null;
+    return { alias, symbol };
+  } catch {
+    return { alias: null, symbol: null };
+  }
+}
