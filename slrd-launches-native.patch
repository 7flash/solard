 export class ExecutionRepo {
@@
   history(limit = 50): ExecutionRow[] {
     return this.db.executions
       .select()
       .orderBy("createdAtMs", "desc")
       .limit(limit)
       .all() as ExecutionRow[];
   }
+
+  /**
+   * Return actual Pump deployments, not every transaction that happened to be
+   * submitted as part of a launch bundle. The deployment builder marks only
+   * the create instructions with action.kind === "launch-pump-token".
+   *
+   * Retry generations can create more than one execution row for the same mint,
+   * so collapse them to the newest generation. A mint itself is unique, making
+   * this a stable one-row-per-launch view.
+   */
+  launchHistory(limit = 100): LaunchExecutionRow[] {
+    const safeLimit = Math.max(1, Math.min(10_000, Math.trunc(limit)));
+    const actions = this.db.executionActions
+      .select()
+      .where({ kind: "launch-pump-token" })
+      .orderBy("createdAtMs", "desc")
+      .all() as ExecutionActionRow[];
+
+    const rows: LaunchExecutionRow[] = [];
+    const seenMints = new Set<string>();
+
+    for (const action of actions) {
+      const execution = this.db.executions
+        .select()
+        .where({ id: action.executionId })
+        .first() as ExecutionRow | undefined;
+      if (!execution) continue;
+
+      const mint = action.mint ?? execution.mint;
+      if (!mint || seenMints.has(mint)) continue;
+      seenMints.add(mint);
+
+      rows.push({
+        execution,
+        action,
+        ...launchActionMetadata(action),
+      });
+      if (rows.length >= safeLimit) break;
+    }
+
+    return rows;
+  }
 }
