{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@solard/core": ["packages/core/src/index.ts"],
      "@solard/sdk": ["packages/sdk/src/index.ts"]
    },
    "types": ["bun", "node"]
  },
  "include": [
    "packages/core/src/**/*.ts",
    "packages/core/src/**/*.d.ts",
    "packages/sdk/src/**/*.ts",
    "packages/cli/src/**/*.ts",
    "packages/cli/bin/**/*.ts"
  ]
}
