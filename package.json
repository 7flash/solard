{
  "name": "sowl",
  "version": "0.0.1",
  "description": "Multi-wallet Solana CLI and SDK for traders and AI agents. Direct venue transactions, encrypted local persistence, and no Jupiter dependency.",
  "type": "module",
  "module": "./src/index.ts",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "slrd": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./venues": "./src/venues/venue-plugin.ts",
    "./claims": "./src/claims/claim-source.ts",
    "./venues/pump": "./src/venues/pump/index.ts",
    "./presets/trader": "./src/presets/trader.ts",
    "./launches": "./src/launches/launch-source.ts",
    "./launchpads": "./src/launches/launchpad.ts",
    "./runner": "./src/runner/config.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "slrd": "bun run ./src/cli.ts",
    "typecheck": "tsc -p ./tsconfig.typecheck.json --noEmit",
    "build": "bun build ./src/index.ts ./src/cli.ts --outdir ./dist --target bun",
    "compile": "bun build ./src/cli.ts --compile --outfile ./bin/slrd",
    "verify": "bun run typecheck && bun run verify:measure-logging && bun run verify:pump-create-encoding",
    "verify:measure-logging": "bun run ./scripts/verify-measure-logging.ts",
    "verify:pump-create-encoding": "bun run ./scripts/verify-pump-create-encoding.ts"
  },
  "keywords": [
    "solana",
    "cli",
    "sdk",
    "trading",
    "pump",
    "pumpfun",
    "memecoin",
    "wallet",
    "automation",
    "ai-agent"
  ],
  "license": "MIT",
  "dependencies": {
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "@subsquid/solana-stream": "^1.1.2",
    "bgrun": "3.13.1",
    "bs58": "^6.0.0",
    "measure-fn": "5",
    "pinata": "^2.5.6",
    "sqlite-zod-orm": "^3.33.0",
    "tradjs": "4.2.0",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  }
}
