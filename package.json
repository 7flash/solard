{
  "name": "winflow",
  "version": "0.6.10",
  "description": "Bun CLI for applying project patches, Git review workflows, project scans, and smart ZIP extraction.",
  "type": "module",
  "bin": {
    "winflow": "./src/cli.mjs"
  },
  "scripts": {
    "start": "bun ./src/cli.mjs",
    "test": "bun test/run.mjs",
    "scan": "bun ./src/cli.mjs scan",
    "review": "bun ./src/cli.mjs review",
    "unzip": "bun ./src/cli.mjs unzip",
    "build:linux-x64": "bun build --compile --target=bun-linux-x64 ./src/cli.mjs --outfile dist/winflow-linux-x64",
    "build:linux-arm64": "bun build --compile --target=bun-linux-arm64 ./src/cli.mjs --outfile dist/winflow-linux-arm64",
    "build:windows-x64": "bun build --compile --target=bun-windows-x64 ./src/cli.mjs --outfile dist/winflow-windows-x64.exe",
    "build:windows-arm64": "bun build --compile --target=bun-windows-arm64 ./src/cli.mjs --outfile dist/winflow-windows-arm64.exe",
    "build:macos-x64": "bun build --compile --target=bun-darwin-x64 ./src/cli.mjs --outfile dist/winflow-macos-x64",
    "build:macos-arm64": "bun build --compile --target=bun-darwin-arm64 ./src/cli.mjs --outfile dist/winflow-macos-arm64",
    "build": "bun run build:linux-x64 && bun run build:linux-arm64 && bun run build:windows-x64 && bun run build:windows-arm64 && bun run build:macos-x64 && bun run build:macos-arm64",
    "apply": "bun ./src/cli.mjs apply",
    "squash": "bun ./src/cli.mjs squash"
  },
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.1.0"
  },
  "keywords": [
    "bun",
    "cli",
    "git",
    "diff",
    "scan",
    "tree",
    "zip",
    "helix",
    "developer-tools"
  ],
  "license": "MIT",
  "dependencies": {
    "@raydium-io/raydium-sdk-v2": "^0.2.63-alpha"
  }
}
